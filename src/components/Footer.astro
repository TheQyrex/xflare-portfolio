---
import { siteConfig } from "../config";
---

<footer class="bg-[#0b0b0c] px-6 py-20 text-white sm:px-10 md:px-16 lg:px-24">
  <div class="mx-auto max-w-[1500px]">
    <p class="section-label !text-white/45">Have a project?</p><a href={siteConfig.social.telegram} target="_blank" rel="noopener noreferrer" class="mt-5 inline-block text-[clamp(2.7rem,8vw,8rem)] font-bold leading-none tracking-[-0.07em] transition hover:opacity-65">Message @qyrex.</a>
    <div class="mt-20 flex flex-col gap-6 border-t border-white/15 pt-8 text-sm text-white/55 sm:flex-row sm:items-center sm:justify-between"><p>© {new Date().getFullYear()} xflare studio</p><div class="flex gap-6"><a href={siteConfig.social.telegram} target="_blank" rel="noopener noreferrer" class="hover:text-white">Telegram</a><a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer" class="hover:text-white">GitHub</a></div></div>
  </div>
</footer>
