---
import { siteConfig } from "../config";
---

<section id="hero" class="relative min-h-screen overflow-hidden bg-[#0b0b0c] text-white">
  <div class="hero-glow absolute inset-0"></div>
  <div class="absolute inset-0 grid-pattern opacity-30"></div>
  <div class="relative mx-auto flex min-h-screen max-w-[1500px] flex-col justify-end px-6 pb-16 pt-32 sm:px-10 md:px-16 lg:px-24 lg:pb-24">
    <div class="mb-auto flex items-center justify-between text-sm uppercase tracking-[0.22em] text-white/55"><span>Development studio</span><span>Independent · Worldwide</span></div>
    <p class="mb-5 text-sm font-semibold uppercase tracking-[0.26em]" style={`color:${siteConfig.accentColor}`}>Design × Engineering × Automation</p>
    <h1 class="max-w-6xl text-[clamp(4.3rem,14vw,12rem)] font-bold leading-[0.78] tracking-[-0.08em]">xflare<span style={`color:${siteConfig.accentColor}`}>.</span></h1>
    <div class="mt-10 grid gap-8 border-t border-white/15 pt-8 md:grid-cols-[1.3fr_1fr] md:items-end">
      <p class="max-w-3xl text-2xl leading-tight text-white/90 sm:text-3xl md:text-5xl">We build digital products that look sharp and work hard.</p>
      <div class="flex flex-wrap gap-3 md:justify-end"><a href="#projects" class="rounded-full bg-white px-6 py-3 font-semibold text-black transition hover:scale-[1.03]">View projects</a><a href={siteConfig.social.telegram} target="_blank" rel="noopener noreferrer" class="rounded-full border border-white/25 px-6 py-3 font-semibold transition hover:bg-white/10">Message on Telegram</a></div>
    </div>
  </div>
</section>
