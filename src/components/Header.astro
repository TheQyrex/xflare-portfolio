---
import { siteConfig } from "../config";
---

<header class="fixed inset-x-0 top-0 z-50 px-4 pt-4 sm:px-6">
  <nav class="mx-auto flex max-w-[1500px] items-center justify-between rounded-full border border-white/15 bg-black/70 px-5 py-3 text-white backdrop-blur-xl">
    <a href="#hero" class="text-xl font-bold tracking-[-0.04em]">xflare<span style={`color:${siteConfig.accentColor}`}>.</span></a>
    <div class="flex items-center gap-5 text-sm font-semibold sm:gap-8"><a href="#about" class="hidden text-white/70 transition hover:text-white sm:block">Studio</a><a href="#projects" class="text-white/70 transition hover:text-white">Projects</a><a href={siteConfig.social.telegram} target="_blank" rel="noopener noreferrer" class="rounded-full bg-white px-4 py-2 text-black">Telegram</a></div>
  </nav>
</header>
