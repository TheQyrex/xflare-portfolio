---
import { siteConfig } from "../config";
---

<section id="projects" class="bg-[#f3f1ed] px-6 py-24 sm:px-10 md:px-16 lg:px-24 lg:py-36">
  <div class="mx-auto max-w-[1500px]">
    <div class="mb-16 flex flex-col gap-6 border-b border-black/15 pb-8 sm:flex-row sm:items-end sm:justify-between">
      <div><p class="section-label">Selected work</p><h2 class="mt-3 text-5xl font-bold tracking-[-0.06em] text-gray-950 sm:text-8xl">Projects</h2></div>
      <p class="max-w-md text-gray-600">Websites, products and automation delivered with equal attention to strategy, visuals and implementation.</p>
    </div>
    <div class="grid gap-6 lg:grid-cols-2">
      {siteConfig.projects.map((project, index) => (
        <article class:list={["project-card group overflow-hidden rounded-[2rem] border border-black/10 bg-white", project.featured && "lg:col-span-2"]}>
          {project.link ? <a href={project.link} target="_blank" rel="noopener noreferrer" class="block overflow-hidden bg-[#111]"><img src={project.image} alt={`${project.name} project preview`} loading="lazy" class:list={["h-[320px] w-full object-cover transition duration-700 group-hover:scale-[1.025] sm:h-[420px]", project.featured && "lg:h-[600px]", project.imageClass]} /></a> : <div class="block overflow-hidden bg-[#111]"><img src={project.image} alt={`${project.name} project preview`} loading="lazy" class:list={["h-[320px] w-full object-cover transition duration-700 group-hover:scale-[1.025] sm:h-[420px]", project.featured && "lg:h-[600px]", project.imageClass]} /></div>}
          <div class="p-6 sm:p-8">
            <p class="text-xs font-bold uppercase tracking-[0.18em]" style={`color:${siteConfig.accentColor}`}>{project.eyebrow}</p>
            <div class="mt-3 flex items-start justify-between gap-5"><h3 class:list={["text-3xl font-bold tracking-[-0.04em] text-gray-950 sm:text-4xl", project.featured && "lg:text-6xl"]}>{project.name}</h3><span class="text-sm text-gray-400">0{index + 1}</span></div>
            <p class="mt-5 text-lg leading-relaxed text-gray-600">{project.description}</p>
            <div class="mt-7 flex flex-wrap gap-2">{project.skills.map((skill) => <span class="rounded-full bg-gray-100 px-3 py-1.5 text-xs font-semibold text-gray-700">{skill}</span>)}</div>
            {project.link && <div class="mt-8 flex flex-wrap gap-5 text-sm font-bold"><a href={project.link} target="_blank" rel="noopener noreferrer" class="link-underline">View project</a></div>}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
