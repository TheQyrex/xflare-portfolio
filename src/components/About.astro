---
import { siteConfig } from "../config";
---

<section id="about" class="mx-auto max-w-[1500px] px-6 py-24 sm:px-10 md:px-16 lg:px-24 lg:py-36">
  <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-4"><p class="section-label">Studio profile</p><h2 class="mt-4 text-5xl font-bold tracking-[-0.05em] text-gray-950 sm:text-7xl">Built for momentum.</h2></div>
    <div class="lg:col-span-8"><p class="max-w-4xl text-2xl leading-relaxed text-gray-700 sm:text-3xl">{siteConfig.aboutMe}</p><div class="mt-12 flex flex-wrap gap-3">{siteConfig.skills.map((skill) => <span class="rounded-full border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-gray-800">{skill}</span>)}</div></div>
  </div>
</section>
